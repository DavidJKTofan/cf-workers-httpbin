{
	// Breakpoint debugging for the Worker.
	// https://developers.cloudflare.com/workers/observability/dev-tools/breakpoints/
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Launch Wrangler",
			"command": "npm run dev",
			"type": "node-terminal",
			"request": "launch",
			"sourceMaps": true
		},
		{
			"name": "Attach to Wrangler",
			"type": "node",
			"request": "attach",
			"port": 9229,
			"cwd": "/",
			"resolveSourceMapLocations": null,
			"attachExistingChildren": false,
			"autoAttachChildProcesses": false,
			"sourceMaps": true
		}
	]
}
