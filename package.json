{
	"name": "cf-workers-httpbin",
	"version": "0.0.0",
	"description": "An httpbin-style HTTP request and response testing service on Cloudflare Workers.",
	"private": true,
	"type": "module",
	"license": "MIT",
	"scripts": {
		"dev": "wrangler dev",
		"start": "wrangler dev",
		"deploy": "wrangler deploy",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc && tsc -p test/tsconfig.json",
		"cf-typegen": "wrangler types",
		"check": "wrangler types --check && npm run typecheck && npm test"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "^1.8.0",
		"@types/node": "^26.6.6",
		"typescript": "^7.0.2",
		"vitest": "^5.1.0",
		"wrangler": "^4.160.1"
	}
}
