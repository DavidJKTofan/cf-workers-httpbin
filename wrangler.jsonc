/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cf-workers-httpbin",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-10",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	// Stack traces in logs point at the TypeScript source instead of the bundle.
	"upload_source_maps": true,
	"assets": {
		// Files here are served directly, without invoking the Worker. Any other
		// path falls through to src/index.ts.
		"directory": "./public",
		// Lets the Worker read assets itself (used by the /image endpoints).
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true,
		"logs": {
			"head_sampling_rate": 1
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 0.1
		}
	},
	// The Worker is reachable only through custom domains: its workers.dev URL and
	// Preview URLs are off. Add a custom domain on a zone in the same account, in the
	// dashboard or here, or set "workers_dev" to true to use the workers.dev URL.
	//
	// "routes": [{ "pattern": "httpbin.example.com", "custom_domain": true }],
	"workers_dev": false,
	"preview_urls": false
}
